rules_version = '2';

// Base de la fase 0: todo cerrado salvo el propio perfil.
// Las reglas por CrewDeck (groups/...) se añaden en la fase 1 siguiendo
// la tabla de "Reglas de seguridad" de docs/documento-tecnico.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
